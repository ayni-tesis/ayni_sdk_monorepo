---
import { Aside } from "@astrojs/starlight/components";
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { breadcrumbTrail } from "../navigation";
import { httpReferenceBase } from "../reference/http-reference";

const trail = breadcrumbTrail(Astro.locals.starlightRoute.sidebar);
// starlight-openapi renders these pages from the OpenAPI document, which has no place for an aside.
const isHttpReference = Astro.url.pathname.startsWith(`/${httpReferenceBase}/`);
---

{
  trail.length > 0 && (
    <nav aria-label="Migas de pan" class="breadcrumbs">
      <ol>
        <li>
          <a href="/">Inicio</a>
        </li>
        {trail.map((crumb) => (
          <li>
            {crumb.href ? (
              <a href={crumb.href} aria-current="page">
                {crumb.label}
              </a>
            ) : (
              <span>{crumb.label}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}
<Default />
{
  isHttpReference && (
    <Aside type="note" title="Nota">
      El SDK llama a estos endpoints por ti. Úsalos directamente solo para depurar o para
      integraciones sin Flutter.
    </Aside>
  )
}

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .breadcrumbs li + li::before {
    content: "/";
    margin-inline-end: 0.5rem;
    color: var(--sl-color-gray-4);
  }

  .breadcrumbs a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }

  .breadcrumbs a:hover,
  .breadcrumbs a[aria-current="page"] {
    color: var(--sl-color-white);
  }
</style>
