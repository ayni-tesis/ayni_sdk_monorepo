---
/** Opens Starlight's search dialog from inside the page content. */
---

<button type="button" class="open-search" data-open-search>Buscar en la documentación</button>

<script>
  for (const button of document.querySelectorAll("[data-open-search]")) {
    button.addEventListener("click", () => {
      document.querySelector<HTMLButtonElement>("site-search [data-open-modal]")?.click();
    });
  }
</script>

<style>
  .open-search {
    padding: 0.5rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999rem;
    background: transparent;
    color: var(--sl-color-white);
    font: inherit;
    cursor: pointer;
  }

  .open-search:hover {
    border-color: var(--sl-color-gray-2);
  }
</style>
